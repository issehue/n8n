{
  "name": "Video Transcription from Google Drive (chunked)",
  "nodes": [
    {
      "parameters": {
        "pollTimes": {
          "item": [
            {
              "mode": "everyMinute"
            }
          ]
        },
        "triggerOn": "specificFolder",
        "folderToWatch": {
          "__rl": true,
          "value": "REPLACE_WITH_DRIVE_FOLDER_ID",
          "mode": "id"
        },
        "event": "fileCreated",
        "options": {}
      },
      "id": "trigger-drive",
      "name": "Google Drive Trigger",
      "type": "n8n-nodes-base.googleDriveTrigger",
      "typeVersion": 1,
      "position": [120, 300],
      "credentials": {
        "googleDriveOAuth2Api": {
          "id": "REPLACE_WITH_GDRIVE_CRED_ID",
          "name": "Google Drive account"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": false,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "mime-check",
              "leftValue": "={{ $json.mimeType }}",
              "rightValue": "video/",
              "operator": {
                "type": "string",
                "operation": "startsWith"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "filter-video",
      "name": "Only Videos",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [320, 300]
    },
    {
      "parameters": {
        "operation": "download",
        "fileId": {
          "__rl": true,
          "value": "={{ $json.id }}",
          "mode": "id"
        },
        "options": {}
      },
      "id": "download-video",
      "name": "Download Video",
      "type": "n8n-nodes-base.googleDrive",
      "typeVersion": 3,
      "position": [520, 260],
      "credentials": {
        "googleDriveOAuth2Api": {
          "id": "REPLACE_WITH_GDRIVE_CRED_ID",
          "name": "Google Drive account"
        }
      }
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const item = $input.item;\nconst j = item.json;\nconst name = j.name || 'video';\nconst ext = name.includes('.') ? name.split('.').pop() : 'mp4';\nconst base = name.replace(/\\.[^.]+$/, '');\nconst id = (j.id || 'x').replace(/[^A-Za-z0-9_-]/g, '_');\nconst workDir = `/tmp/n8n-transcribe-${id}-${Date.now()}`;\n\nreturn {\n  json: {\n    ...j,\n    originalName: name,\n    baseName: base,\n    workDir,\n    inputPath: `${workDir}/input.${ext}`,\n    chunksDir: `${workDir}/chunks`\n  },\n  binary: item.binary\n};"
      },
      "id": "prepare-paths",
      "name": "Prepare Paths",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [720, 260]
    },
    {
      "parameters": {
        "operation": "write",
        "fileName": "={{ $json.inputPath }}",
        "dataPropertyName": "data",
        "options": {
          "append": false
        }
      },
      "id": "write-video",
      "name": "Write Video to Disk",
      "type": "n8n-nodes-base.readWriteFile",
      "typeVersion": 1,
      "position": [920, 260]
    },
    {
      "parameters": {
        "command": "=mkdir -p \"{{ $json.chunksDir }}\" && ffmpeg -y -loglevel error -i \"{{ $json.inputPath }}\" -vn -ac 1 -ar 16000 -b:a 64k -f segment -segment_time 600 -reset_timestamps 1 \"{{ $json.chunksDir }}/chunk_%03d.mp3\" && ls \"{{ $json.chunksDir }}\"/*.mp3 | sort"
      },
      "id": "ffmpeg-split",
      "name": "Extract & Split Audio (ffmpeg)",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [1120, 260]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const stdout = $input.first().json.stdout || '';\nconst paths = stdout.split('\\n').map(s => s.trim()).filter(Boolean);\nif (paths.length === 0) {\n  throw new Error('ffmpeg produced no chunks. stderr: ' + ($input.first().json.stderr || ''));\n}\nreturn paths.map((p, i) => ({ json: { chunkPath: p, chunkIndex: i } }));"
      },
      "id": "parse-chunks",
      "name": "Parse Chunk List",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1320, 260]
    },
    {
      "parameters": {
        "operation": "read",
        "fileSelector": "={{ $json.chunkPath }}",
        "options": {
          "dataPropertyName": "data"
        }
      },
      "id": "read-chunk",
      "name": "Read Chunk",
      "type": "n8n-nodes-base.readWriteFile",
      "typeVersion": 1,
      "position": [1520, 260]
    },
    {
      "parameters": {
        "resource": "audio",
        "operation": "transcribe",
        "binaryPropertyName": "data",
        "options": {}
      },
      "id": "transcribe",
      "name": "Transcribe (Whisper)",
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "typeVersion": 1.8,
      "position": [1720, 260],
      "credentials": {
        "openAiApi": {
          "id": "REPLACE_WITH_OPENAI_CRED_ID",
          "name": "OpenAI account"
        }
      }
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const items = $input.all();\nconst text = items.map(i => (i.json.text || '').trim()).filter(Boolean).join('\\n\\n');\nconst base = $('Prepare Paths').first().json.baseName || 'transcript';\nconst fileName = `${base}.txt`;\n\nreturn [{\n  json: { fileName, text },\n  binary: {\n    data: {\n      data: Buffer.from(text, 'utf8').toString('base64'),\n      mimeType: 'text/plain',\n      fileName\n    }\n  }\n}];"
      },
      "id": "join-transcripts",
      "name": "Join Transcripts",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1920, 260]
    },
    {
      "parameters": {
        "operation": "upload",
        "name": "={{ $json.fileName }}",
        "driveId": {
          "__rl": true,
          "mode": "list",
          "value": "My Drive"
        },
        "folderId": {
          "__rl": true,
          "value": "REPLACE_WITH_DRIVE_FOLDER_ID",
          "mode": "id"
        },
        "options": {}
      },
      "id": "upload-transcript",
      "name": "Upload Transcript",
      "type": "n8n-nodes-base.googleDrive",
      "typeVersion": 3,
      "position": [2120, 260],
      "credentials": {
        "googleDriveOAuth2Api": {
          "id": "REPLACE_WITH_GDRIVE_CRED_ID",
          "name": "Google Drive account"
        }
      }
    },
    {
      "parameters": {
        "command": "=rm -rf \"{{ $('Prepare Paths').first().json.workDir }}\""
      },
      "id": "cleanup",
      "name": "Cleanup Tmp",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [2320, 260]
    }
  ],
  "connections": {
    "Google Drive Trigger": {
      "main": [[{ "node": "Only Videos", "type": "main", "index": 0 }]]
    },
    "Only Videos": {
      "main": [[{ "node": "Download Video", "type": "main", "index": 0 }]]
    },
    "Download Video": {
      "main": [[{ "node": "Prepare Paths", "type": "main", "index": 0 }]]
    },
    "Prepare Paths": {
      "main": [[{ "node": "Write Video to Disk", "type": "main", "index": 0 }]]
    },
    "Write Video to Disk": {
      "main": [[{ "node": "Extract & Split Audio (ffmpeg)", "type": "main", "index": 0 }]]
    },
    "Extract & Split Audio (ffmpeg)": {
      "main": [[{ "node": "Parse Chunk List", "type": "main", "index": 0 }]]
    },
    "Parse Chunk List": {
      "main": [[{ "node": "Read Chunk", "type": "main", "index": 0 }]]
    },
    "Read Chunk": {
      "main": [[{ "node": "Transcribe (Whisper)", "type": "main", "index": 0 }]]
    },
    "Transcribe (Whisper)": {
      "main": [[{ "node": "Join Transcripts", "type": "main", "index": 0 }]]
    },
    "Join Transcripts": {
      "main": [[{ "node": "Upload Transcript", "type": "main", "index": 0 }]]
    },
    "Upload Transcript": {
      "main": [[{ "node": "Cleanup Tmp", "type": "main", "index": 0 }]]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "pinData": {},
  "meta": {
    "description": "Watches a Google Drive folder for new video files, extracts audio with ffmpeg, splits into 10-minute chunks to stay under the Whisper 25 MB limit, transcribes each chunk via OpenAI Whisper, joins the results and uploads the transcript as a .txt file back to the same folder."
  }
}
